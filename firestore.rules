rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'salim@gmail.com' ||
        request.auth.token.email == 'n10517529@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Users collection rules:
    // Allow read for cross-device sponsor code & unique username lookup before login
    match /users/{userId} {
      allow read: if true;
      allow write: if true;

      // Sub-collection: transactions
      match /transactions/{transactionId} {
        allow read, write: if true;
      }

      // Sub-collection: referrals
      match /referrals/{referralId} {
        allow read, write: if true;
      }
    }

    // Educational credentials audit vault
    match /user_vault/{userId} {
      allow read, write: if true;
    }

    // Referral codes lookup registry (needed for cross-device registration validation)
    match /referral_codes/{code} {
      allow read, write: if true;
    }

    // Unique usernames registry (needed for username uniqueness & username-as-referral-code)
    match /usernames/{username} {
      allow read, write: if true;
    }

    // System transactions ledger for Admin Panel & user audit
    match /system_transactions/{txId} {
      allow read, write: if true;
    }

    // Dedicated withdrawals collection for institutional audit & settlement
    match /withdrawals/{txId} {
      allow read, write: if true;
    }

    // Real-time multi-tier team referrals tracking (Level 1, Level 2, Level 3)
    match /team_referrals/{refId} {
      allow read, write: if true;
    }

    // Real-time referral commissions ledger
    match /referral_commissions/{commId} {
      allow read, write: if true;
    }

    // Fallback: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
